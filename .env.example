# Where the Next.js server reaches the API (server-side rendering + /api rewrite).
# On Vercel: the API's address on Render, e.g. https://trendz-api.onrender.com
# (no trailing slash). Changing it needs a rebuild of the web app.
API_INTERNAL_URL=http://127.0.0.1:4100
# Public site URL (canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# Origin(s) that pictures are shown from and uploaded to, separated by spaces: they are
# the only outside addresses the browser may load images from. R2: its public
# domain. Cloudinary: https://res.cloudinary.com https://api.cloudinary.com
# Changing this needs a rebuild of the web app.
NEXT_PUBLIC_MEDIA_ORIGIN=http://localhost:9100
NEXT_PUBLIC_STORE_NAME=Trendz Women's Wear
